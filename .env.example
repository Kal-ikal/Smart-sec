# =====================================================================
# JANGAN pernah commit file .env asli. File ini hanya template.
#
# CATATAN ARSITEKTUR PENTING:
#   SUPABASE_SERVICE_ROLE_KEY hanya boleh berada di apps/worker/.env
#   (server-side, tidak pernah dikirim ke browser). Jika key ini bocor
#   ke apps/web, seluruh RLS di database bisa di-bypass dari klien.
# =====================================================================

# --- Dipakai oleh apps/web (aman untuk browser, prefix NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Dipakai HANYA oleh apps/worker (rahasia, server-side saja) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # bypass RLS -- jaga kerahasiaannya

# --- OWASP ZAP (worker memanggil instance ZAP yang berjalan terpisah,
#     mis. via Docker: docker run -u zap -p 8080:8080 zaproxy/zap-stable
#     zap.sh -daemon -host 0.0.0.0 -port 8080 -config api.disablekey=true
#     Atau set ZAP_MOCK=true untuk mode simulasi tanpa menginstal ZAP) ---
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
ZAP_MOCK=true


# --- Identitas worker instance (untuk kolom claimed_by, audit trail) ---
WORKER_ID=worker-local-1

# --- Rate limiting (Token Bucket) sesuai Batasan Masalah proposal ---
RATE_LIMIT_TOKENS_PER_SECOND=2
RATE_LIMIT_BUCKET_CAPACITY=10

# --- WhatsApp Alert Notification (Fonnte / Wablas / Generic Gateway) ---
WA_ENABLED=false
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=your-whatsapp-gateway-token
WA_TARGET_PHONE=6281234567890

